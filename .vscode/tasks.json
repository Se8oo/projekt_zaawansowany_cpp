{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and run HomeLibrary",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\run.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Builds the whole project and runs build\\HomeLibrary.exe"
        }
    ]
}
