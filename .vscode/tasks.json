{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-I.",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
        ,
        {
            "label": "Build Project",
            "type": "shell",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-g",
                "src/main.cpp",
                "src/core/Library.cpp",
                "src/models/Author.cpp",
                "src/models/Category.cpp",
                "src/models/Item.cpp",
                "src/utils/FileStorage.cpp",
                "-I.",
                "-o",
                "${workspaceFolder}\\bin\\projekt.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Project build task: compiles all sources to bin\\projekt.exe"
        }
    ],
    "version": "2.0.0"
}